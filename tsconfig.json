{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "moduleResolution": "node10",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["photoshop", "@adobe/cc-ext-uxp-types"],
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "esModuleInterop": false,
        "forceConsistentCasingInFileNames": true,
        "rootDir": "src",
        "outDir": "build",
        "sourceMap": true
    },
    "include": ["src/**/*.ts", "src/**/*.json"]
}
